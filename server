const WebSocket = require('ws');
const http = require('http');

const PORT = process.env.PORT || 3000;

const fs = require('fs');
const path = require('path');
const server = http.createServer((req, res) => {
  let filePath = '.' + req.url;
  if (filePath == './') filePath = './index.html';

  const extname = String(path.extname(filePath)).toLowerCase();
  const mimeTypes = {
    '.html': 'text/html',
    '.js': 'text/javascript',
    '.css': 'text/css',
    '.json': 'application/json',
    '.png': 'image/png',
    '.jpg': 'image/jpg',
    '.gif': 'image/gif',
    '.wav': 'audio/wav',
    '.mp4': 'video/mp4',
    '.woff': 'application/font-woff',
    '.ttf': 'application/font-ttf',
    '.eot': 'application/vnd.ms-fontobject',
    '.otf': 'application/font-otf',
    '.svg': 'application/image/svg+xml'
  };

  const contentType = mimeTypes[extname] || 'application/octet-stream';

  fs.readFile(filePath, function(error, content) {
    if (error) {
      if(error.code == 'ENOENT'){
        res.writeHead(404, { 'Content-Type': 'text/plain' });
        res.end('404 Not Found\n');
      } else {
        res.writeHead(500);
        res.end('Sorry, check with the site admin for error: '+error.code+' ..\n');
      }
    } else {
      res.writeHead(200, { 'Content-Type': contentType });
      res.end(content, 'utf-8');
    }
  });
});

const wss = new WebSocket.Server({ server });

// ---------- Вспомогательные функции ----------

function distSq(x1, y1, x2, y2) {
    return (x2 - x1) ** 2 + (y2 - y1) ** 2;
}

const COLORS = [
    '#00aaff', '#ff4444', '#44ff44', '#ffaa00',
    '#ff44ff', '#44ffff', '#ffff44', '#ff8844',
    '#8844ff', '#44ff88'
];

const UPGRADES = [
    () => ({ dmg: 1.3,  desc: '+30% к урону' }),
    () => ({ spd: 1.15, desc: '+15% к скорости' }),
    () => ({ aspd: 0.8, desc: '+20% к скорости атаки' }),
    () => ({ hp: 30,    desc: '+30 к макс. HP и лечение' }),
    () => ({ pier: 1,   desc: '+1 пробивание' }),
    () => ({ mag: 1.5,  desc: '+50% к радиусу сбора' })
];

// ---------- Класс комнаты ----------

class Room {
    constructor(name) {
        this.name = name;
        this.players = new Map();
        this.enemies = [];
        this.projectiles = [];
        this.gems = [];
        this.time = 0;
        this.kills = 0;
        this.spawnTimer = 0;
        this.difficulty = 1;
        this.nextId = 0;
        this.aliveCount = 0;
        this.interval = null;
        this.running = false;
    }

    addPlayer(ws, playerName) {
        const id = this.nextId++;
        const color = COLORS[id % COLORS.length];
        const player = {
            id, name: playerName, color, ws,
            x: 0, y: 0, radius: 15, speed: 250,
            hp: 100, maxHp: 100,
            level: 1, xp: 0, xpNeeded: 50,
            weaponDelay: 0.8, weaponTimer: 0,
            damage: 10, projSpeed: 600, pierce: 1, pickupRadius: 60,
            keys: { w: false, a: false, s: false, d: false },
            alive: true
        };

        this.players.set(id, player);
        this.aliveCount++;

        ws.send(JSON.stringify({ type: 'init', id, color }));

        this.broadcast({
            type: 'join',
            id: player.id,
            name: player.name,
            color: player.color
        });

        if (this.players.size === 1 && !this.running) {
            this.startGame();
        }

        ws.on('message', (raw) => {
            try {
                const msg = JSON.parse(raw);
                if (msg.type === 'input' && player.alive) {
                    player.keys = msg.keys;
                }
            } catch (e) { /* ignore bad json */ }
        });

        ws.on('close', () => {
            this.players.delete(id);
            this.aliveCount--;
            this.broadcast({ type: 'leave', id });
            if (this.aliveCount <= 0 && this.running) {
                this.stopGame();
            }
            if (this.players.size === 0 && this.running) {
                this.stopGame();
            }
        });

        return player;
    }

    startGame() {
        if (this.running) return;
        this.running = true;
        console.log(`[${this.name}] Игра началась!`);
        this.interval = setInterval(() => this.tick(), 50);
    }

    stopGame() {
        this.running = false;
        if (this.interval) {
            clearInterval(this.interval);
            this.interval = null;
        }
        console.log(`[${this.name}] Игра окончена`);
    }

    tick() {
        const dt = 0.05; // 20 ticks/сек

        // ------ Движение игроков и стрельба ------
        for (const p of this.players.values()) {
            if (!p.alive) continue;

            let dx = 0, dy = 0;
            if (p.keys.w) dy -= 1;
            if (p.keys.s) dy += 1;
            if (p.keys.a) dx -= 1;
            if (p.keys.d) dx += 1;

            if (dx !== 0 || dy !== 0) {
                const len = Math.sqrt(dx * dx + dy * dy);
                p.x += (dx / len) * p.speed * dt;
                p.y += (dy / len) * p.speed * dt;
            }

            // Автоматическая стрельба
            p.weaponTimer += dt;
            if (p.weaponTimer >= p.weaponDelay && this.enemies.length > 0) {
                let target = null;
                let minDist = Infinity;
                for (const e of this.enemies) {
                    const d = distSq(p.x, p.y, e.x, e.y);
                    if (d < minDist) {
                        minDist = d;
                        target = e;
                    }
                }
                if (target) {
                    const angle = Math.atan2(target.y - p.y, target.x - p.x);
                    this.projectiles.push({
                        x: p.x,
                        y: p.y,
                        vx: Math.cos(angle) * p.projSpeed,
                        vy: Math.sin(angle) * p.projSpeed,
                        damage: p.damage,
                        pierce: p.pierce,
                        life: 2,
                        radius: 4,
                        hitEnemies: new Set()
                    });
                }
                p.weaponTimer = 0;
            }
        }

        // ------ Снаряды ------
        for (let i = this.projectiles.length - 1; i >= 0; i--) {
            const pr = this.projectiles[i];
            pr.x += pr.vx * dt;
            pr.y += pr.vy * dt;
            pr.life -= dt;

            if (pr.life <= 0) {
                this.projectiles.splice(i, 1);
                continue;
            }

            let destroyed = false;
            for (let j = this.enemies.length - 1; j >= 0; j--) {
                const e = this.enemies[j];
                if (pr.hitEnemies.has(e)) continue;
                if (distSq(pr.x, pr.y, e.x, e.y) < (pr.radius + e.radius) ** 2) {
                    pr.hitEnemies.add(e);
                    e.hp -= pr.damage;
                    if (e.hp <= 0) {
                        this.gems.push({ x: e.x, y: e.y, xp: e.xp, radius: 4 });
                        this.enemies.splice(j, 1);
                        this.kills++;
                    }
                    if (pr.hitEnemies.size >= pr.pierce) {
                        destroyed = true;
                        break;
                    }
                }
            }
            if (destroyed) this.projectiles.splice(i, 1);
        }

        // Кешируем живых игроков для оптимизации O(N*M) циклов
        const alivePlayers = [];
        for (const p of this.players.values()) {
            if (p.alive) alivePlayers.push(p);
        }

        // ------ Враги ------
        for (let i = this.enemies.length - 1; i >= 0; i--) {
            const e = this.enemies[i];

            let nearest = null;
            let minDist = Infinity;
            for (let j = 0; j < alivePlayers.length; j++) {
                const p = alivePlayers[j];
                if (!p.alive) continue;
                const d = distSq(e.x, e.y, p.x, p.y);
                if (d < minDist) {
                    minDist = d;
                    nearest = p;
                }
            }

            if (!nearest) {
                this.enemies.splice(i, 1);
                continue;
            }

            const angle = Math.atan2(nearest.y - e.y, nearest.x - e.x);
            e.x += Math.cos(angle) * e.speed * dt;
            e.y += Math.sin(angle) * e.speed * dt;

            if (minDist < (e.radius + nearest.radius) ** 2) {
                nearest.hp -= e.damage;
                e.x -= Math.cos(angle) * 30;
                e.y -= Math.sin(angle) * 30;

                if (nearest.hp <= 0) {
                    nearest.hp = 0;
                    nearest.alive = false;
                    this.aliveCount--;
                    this.broadcast({ type: 'playerDied', id: nearest.id, name: nearest.name });

                    if (this.aliveCount <= 0) {
                        this.broadcast({
                            type: 'gameOver',
                            time: Math.round(this.time),
                            kills: this.kills
                        });
                        this.stopGame();
                        return;
                    }
                }
            }
        }

        // ------ Магнит для кристаллов ------
        for (const g of this.gems) {
            for (let j = 0; j < alivePlayers.length; j++) {
                const p = alivePlayers[j];
                if (!p.alive) continue;
                const d = distSq(g.x, g.y, p.x, p.y);
                if (d < p.pickupRadius ** 2) {
                    const a = Math.atan2(p.y - g.y, p.x - g.x);
                    g.x += Math.cos(a) * 400 * dt;
                    g.y += Math.sin(a) * 400 * dt;
                }
            }
        }

        // ------ Подбор кристаллов ------
        for (let i = this.gems.length - 1; i >= 0; i--) {
            const g = this.gems[i];
            let picked = false;
            for (let j = 0; j < alivePlayers.length; j++) {
                const p = alivePlayers[j];
                if (!p.alive) continue;
                if (distSq(g.x, g.y, p.x, p.y) < (p.radius + g.radius) ** 2) {
                    p.xp += g.xp;
                    this.gems.splice(i, 1);

                    // Проверка на левелап
                    let leveled = false;
                    while (p.xp >= p.xpNeeded) {
                        p.xp -= p.xpNeeded;
                        p.level++;
                        p.xpNeeded = Math.floor(p.xpNeeded * 1.5);
                        const u = UPGRADES[Math.floor(Math.random() * UPGRADES.length)]();
                        if (u.dmg) p.damage *= u.dmg;
                        if (u.spd) p.speed *= u.spd;
                        if (u.aspd) p.weaponDelay *= u.aspd;
                        if (u.hp) {
                            p.maxHp += u.hp;
                            p.hp = Math.min(p.hp + u.hp, p.maxHp);
                        }
                        if (u.pier) p.pierce += u.pier;
                        if (u.mag) p.pickupRadius *= u.mag;
                        leveled = true;
                    }
                    if (leveled) {
                        p.ws.send(JSON.stringify({
                            type: 'levelUp',
                            level: p.level,
                            desc: 'Авто-прокачка'
                        }));
                    }

                    picked = true;
                    break;
                }
            }
            if (picked) continue;
        }

        // ------ Спавн врагов ------
        this.spawnTimer += dt;
        const spawnRate = Math.max(0.15, 1.0 - this.time / 250);

        if (this.spawnTimer >= spawnRate) {
            this.spawnTimer = 0;

            // Центр массы живых игроков
            let cx = 0, cy = 0, cnt = 0;
            for (const p of this.players.values()) {
                if (p.alive) {
                    cx += p.x;
                    cy += p.y;
                    cnt++;
                }
            }
            if (cnt === 0) { cx = 0; cy = 0; cnt = 1; }
            cx /= cnt;
            cy /= cnt;

            const angle = Math.random() * Math.PI * 2;
            const radius = 450;
            const sx = cx + Math.cos(angle) * radius;
            const sy = cy + Math.sin(angle) * radius;

            const df = this.difficulty;
            const rnd = Math.random();
            let enemy;

            if (rnd > 0.9) {
                // Танк
                enemy = {
                    x: sx, y: sy,
                    hp: 80 * df, maxHp: 80 * df,
                    speed: 60 + df * 5, radius: 20,
                    damage: 25, xp: 30,
                    color: '#880000'
                };
            } else if (rnd > 0.7) {
                // Быстрый
                enemy = {
                    x: sx, y: sy,
                    hp: 10 * df, maxHp: 10 * df,
                    speed: 220 + df * 15, radius: 8,
                    damage: 5, xp: 15,
                    color: '#ffaa00'
                };
            } else {
                // Обычный
                enemy = {
                    x: sx, y: sy,
                    hp: 20 * df, maxHp: 20 * df,
                    speed: 100 + df * 10, radius: 12,
                    damage: 10, xp: 10,
                    color: '#ff3300'
                };
            }
            this.enemies.push(enemy);
        }

        // ------ Обновление времени ------
        this.time += dt;
        this.difficulty = 1 + (this.time / 60);

        // ------ Рассылка состояния ------
        this.broadcastState();
    }

    broadcastState() {
        const playersArr = [];
        for (const p of this.players.values()) {
            playersArr.push({
                id: p.id,
                name: p.name,
                color: p.color,
                x: Math.round(p.x),
                y: Math.round(p.y),
                hp: Math.round(p.hp),
                maxHp: p.maxHp,
                level: p.level,
                xp: p.xp,
                xpNeeded: p.xpNeeded,
                alive: p.alive
            });
        }

        const enemiesArr = this.enemies.map(e => ({
            x: Math.round(e.x),
            y: Math.round(e.y),
            hp: Math.round(e.hp),
            maxHp: e.maxHp,
            radius: e.radius,
            color: e.color
        }));

        const projArr = this.projectiles.map(p => ({
            x: Math.round(p.x),
            y: Math.round(p.y),
            radius: p.radius
        }));

        const gemsArr = this.gems.map(g => ({
            x: Math.round(g.x),
            y: Math.round(g.y)
        }));

        this.broadcast({
            type: 'state',
            players: playersArr,
            enemies: enemiesArr,
            projectiles: projArr,
            gems: gemsArr,
            time: Math.round(this.time),
            kills: this.kills,
            aliveCount: this.aliveCount
        });
    }

    broadcast(msg) {
        const data = JSON.stringify(msg);
        for (const p of this.players.values()) {
            if (p.ws.readyState === WebSocket.OPEN) {
                p.ws.send(data);
            }
        }
    }
}

// ---------- Управление комнатами ----------

const rooms = new Map();

wss.on('connection', (ws) => {
    let playerRef = null;
    let roomRef = null;

    ws.on('message', (raw) => {
        try {
            const msg = JSON.parse(raw);
            if (msg.type === 'join') {
                const roomName = (msg.room || 'default').trim();
                const playerName = (msg.name || 'Игрок').trim().slice(0, 12);

                if (!rooms.has(roomName)) {
                    rooms.set(roomName, new Room(roomName));
                }

                const room = rooms.get(roomName);

                if (room.players.size >= 10) {
                    ws.send(JSON.stringify({
                        type: 'error',
                        message: 'Комната полна (макс. 10 игроков)'
                    }));
                    return;
                }

                roomRef = room;
                playerRef = room.addPlayer(ws, playerName);
            }
        } catch (e) { /* ignore */ }
    });

    ws.on('close', () => {
        if (roomRef && playerRef) {
            roomRef.players.delete(playerRef.id);
            roomRef.aliveCount--;
            roomRef.broadcast({ type: 'leave', id: playerRef.id });

            if (roomRef.aliveCount <= 0 && roomRef.running) {
                roomRef.stopGame();
            }

            if (roomRef.players.size === 0) {
                roomRef.stopGame();
                rooms.delete(roomRef.name);
            }
        }
    });
});

server.listen(PORT, () => {
    console.log(`🔥 Hellbreak сервер запущен на порту ${PORT}`);
    console.log(`   Подключайся: ws://localhost:${PORT}`);
});
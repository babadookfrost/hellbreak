};

const WEAPON_KEYS = Object.keys(WEAPONS);

// ========== ПАССИВКИ ==========
const PASSIVES = [
    () => ({ key: 'dmg', desc: '+30% урона', apply: p => p.damage *= 1.3 }),
    () => ({ key: 'spd', desc: '+15% скорости бега', apply: p => p.speed *= 1.15 }),
    () => ({ key: 'aspd', desc: '+20% скорости атаки', apply: p => p.attackSpeed *= 0.8 }),
    () => ({ key: 'hp', desc: '+30 HP', apply: p => { p.maxHp += 30; p.hp = Math.min(p.hp + 30, p.maxHp); } }),
    () => ({ key: 'pierce', desc: '+1 пробивание', apply: p => p.pierceBonus += 1 }),
    () => ({ key: 'magnet', desc: '+50% радиус сбора', apply: p => p.pickupRadius *= 1.5 })
];

// ========== КОМНАТА ==========
class Room {
    constructor(name) {
        this.name = name;
        this.players = new Map();
        this.enemies = [];
        this.projectiles = [];
        this.gems = [];
        this.firepools = [];
        this.time = 0;
        this.kills = 0;
        this.spawnTimer = 0;
        this.difficultyMultiplier = 1;
        this.nextId = 0;
        this.aliveCount = 0;
        this.interval = null;
    }

    addPlayer(ws, name) {
        const id = this.nextId++;
        const color = COLORS[this.players.size % COLORS.length];
        const player = {
            id, name, color, ws,
            x: 0, y: 0, radius: 15, speed: 250,
            hp: 100, maxHp: 100,
            level: 1, xp: 0, xpNeeded: 50,
            damage: 10, attackSpeed: 1, pierceBonus: 0, pickupRadius: 60,
            weapons: [{ id: 'fireball', level: 1, timer: 0 }],
            keys: { w: false, a: false, s: false, d: false },
            alive: true
        };
        this.players.set(id, player);
        this.aliveCount++;

        if (this.players.size === 1) this.start();

        ws.on('message', (data) => {
            try {
                const msg = JSON.parse(data);
                if (msg.type === 'input' && player.alive) {
                    player.keys = msg.keys;
                }
            } catch(e) {}
        });

        ws.on('close', () => {
            if (this.players.has(id)) {
                this.players.delete(id);
                this.aliveCount--;
                this.broadcast({ type: 'leave', id });
                if (this.aliveCount <= 0) this.stop();
                if (this.players.size === 0) rooms.delete(this.name);
            }
        });

        ws.send(JSON.stringify({ type: 'init', id, color }));
        this.broadcast({ type: 'join', id, name, color });
        return player;
    }

    start() {
        console.log(`Room ${this.name} started (${this.players.size} players)`);
        this.interval = setInterval(() => this.tick(), 50);
    }

    stop() {
        if (this.interval) { clearInterval(this.interval); this.interval = null; }
        console.log(`Room ${this.name} stopped`);
    }

    getStats(weaponId, level) {
        if (level >= 9 && EVOLUTIONS[weaponId]) return EVOLUTIONS[weaponId];
        return WEAPONS[weaponId] || WEAPONS.fireball;
    }

    tick() {
        const dt = 0.05;
        const alivePlayers = [...this.players.values()].filter(p => p.alive);
        if (alivePlayers.length === 0) return;

        // --- ДВИЖЕНИЕ ИГРОКОВ ---
        for (const p of alivePlayers) {
            let dx = 0, dy = 0;
            if (p.keys.w) dy -= 1; if (p.keys.s) dy += 1;
            if (p.keys.a) dx -= 1; if (p.keys.d) dx += 1;
            if (dx !== 0 || dy !== 0) {
                const len = Math.sqrt(dx*dx + dy*dy);
                p.x += (dx/len) * p.speed * dt;
                p.y += (dy/len) * p.speed * dt;
            }

            // --- СТРЕЛЬБА ИЗ ВСЕГО ОРУЖИЯ ---
            for (const w of p.weapons) {
                w.timer += dt;
                const stats = this.getStats(w.id, w.level);
                const delay = stats.delay * p.attackSpeed;

                if (w.timer >= delay) {
                    w.timer = 0;
                    const pDmg = stats.dmg * (1 + (w.level-1) * 0.25) * (p.damage / 10);

                    if (stats.aura) {
                        // Аура — бьёт всех врагов в радиусе
                        for (const e of this.enemies) {
                            if (dist(p.x, p.y, e.x, e.y) < stats.radius) e.hp -= pDmg;
                        }
                        if (stats.heal) p.hp = Math.min(p.maxHp, p.hp + stats.heal);
                        // Визуальный эффект
                        this.projectiles.push(this.makeProj(p.x, p.y, 0, 0, 0, 99, 0.15, stats.radius, stats.color));
                    } else {
                        // Обычные снаряды — ищут цель
                        let target = null, minDist = Infinity;
                        for (const e of this.enemies) {
                            const d = dist(p.x, p.y, e.x, e.y);
                            if (d < minDist) { minDist = d; target = e; }
                        }
                        if (target) {
                            const angle = Math.atan2(target.y - p.y, target.x - p.x);
                            const pierce = stats.pierce + p.pierceBonus;
                            this.projectiles.push(this.makeProj(
                                p.x, p.y,
                                Math.cos(angle) * stats.speed,
                                Math.sin(angle) * stats.speed,
                                pDmg, pierce, 2.5,
                                stats.radius + Math.floor(w.level/2),
                                stats.color,
                                w.level >= 9 ? stats : null
                            ));
                        }
                    }
                }
            }

            // Урон от огненных луж
            for (const pool of this.firepools) {
                if (dist(p.x, p.y, pool.x, pool.y) < 30) {
                    p.hp -= pool.damage * dt;
                    if (p.hp <= 0) { p.hp = 0; p.alive = false; this.aliveCount--; this.broadcast({ type: 'playerDied', id: p.id }); }
                }
            }
        }

        // --- СНАРЯДЫ ---
        for (let i = this.projectiles.length-1; i >= 0; i--) {
            const pr = this.projectiles[i];
            pr.x += pr.vx * dt;
            pr.y += pr.vy * dt;
            pr.life -= dt;
            if (pr.life <= 0) { this.projectiles.splice(i,1); continue; }

            if (pr.damage <= 0) continue; // чисто визуальные

            let destroyed = false;
            for (let j = this.enemies.length-1; j >= 0; j--) {
                const e = this.enemies[j];
                if (pr.hitEnemies.has(e) || dist(pr.x, pr.y, e.x, e.y) >= pr.radius + e.radius) continue;
                pr.hitEnemies.add(e);
                e.hp -= pr.damage;

                // ЭФФЕКТЫ ЭВОЛЮЦИЙ
                if (pr.effect) {
                    // Заморозка
                    if (pr.effect.freeze) {
                        e.speed = Math.max(20, (e.baseSpeed || e.speed) * 0.3);
                        e.freezeTimer = pr.effect.freeze;
                    }
                    // Притяжение (чёрная дыра)
                    if (pr.effect.pull) {
                        const a = Math.atan2(pr.y - e.y, pr.x - e.x);
                        e.x += Math.cos(a) * pr.effect.pull * dt;
                        e.y += Math.sin(a) * pr.effect.pull * dt;
                    }
                    // AoE взрыв (инферно)
                    if (pr.effect.aoe) {
                        for (const ae of this.enemies) {
                            if (ae !== e && dist(pr.x, pr.y, ae.x, ae.y) < pr.effect.aoe) {
                                ae.hp -= pr.damage * 0.5;
                            }
                        }
                        this.projectiles.push(this.makeProj(pr.x, pr.y, 0, 0, 0, 99, 0.2, pr.effect.aoe, 'rgba(255,60,0,0.3)'));
                    }
                    // Огненная лужа (хеллфайр)
                    if (pr.effect.pool) {
                        this.firepools.push({ x: pr.x, y: pr.y, damage: pr.damage * 0.3, timer: 3 });
                    }
                }

                if (e.hp <= 0) {
                    this.gems.push({ x: e.x, y: e.y, xp: e.xp || 10, radius: 4 });
                    this.enemies.splice(j, 1);
                    this.kills++;
                }
                if (pr.hitEnemies.size >= pr.pierce) { destroyed = true; break; }
            }
            if (destroyed) this.projectiles.splice(i, 1);
        }

        // --- ОГНЕННЫЕ ЛУЖИ ---
        for (let i = this.firepools.length-1; i >= 0; i--) {
            const pool = this.firepools[i];
            pool.timer -= dt;
            for (const e of this.enemies) {
                if (dist(pool.x, pool.y, e.x, e.y) < 30) {
                    e.hp -= pool.damage * dt;
                }
            }
            // Визуал для луж
            this.projectiles.push(this.makeProj(pool.x, pool.y, 0, 0, 0, 99, 0.05, 30, 'rgba(255,0,80,0.2)'));
            if (pool.timer <= 0) this.firepools.splice(i, 1);
        }

        // --- ВРАГИ ---
        for (let i = this.enemies.length-1; i >= 0; i--) {
            const e = this.enemies[i];

            // Разморозка
            if (e.freezeTimer) {
                e.freezeTimer -= dt;
                if (e.freezeTimer <= 0) e.speed = e.baseSpeed || e.speed;
            }

            // Поиск ближайшего игрока
            let nearest = null, minDist = Infinity;
            for (const p of alivePlayers) {
                const d = dist(e.x, e.y, p.x, p.y);
                if (d < minDist) { minDist = d; nearest = p; }
            }
            if (!nearest) continue;

            const angle = Math.atan2(nearest.y - e.y, nearest.x - e.x);
            e.x += Math.cos(angle) * e.speed * dt;
            e.y += Math.sin(angle) * e.speed * dt;

            if (minDist < e.radius + nearest.radius) {
                nearest.hp -= e.damage;
                e.x -= Math.cos(angle) * 30;
                e.y -= Math.sin(angle) * 30;
                if (nearest.hp <= 0) {
                    nearest.hp = 0; nearest.alive = false;
                    this.aliveCount--;
                    this.broadcast({ type: 'playerDied', id: nearest.id });
                    if (this.aliveCount <= 0) { this.broadcast({ type: 'gameOver' }); this.stop(); return; }
                }
            }
        }

        // --- КРИСТАЛЛЫ ---
        for (const g of this.gems) {
            for (const p of alivePlayers) {
                const d = dist(g.x, g.y, p.x, p.y);
                if (d < p.pickupRadius) {
                    const a = Math.atan2(p.y - g.y, p.x - g.x);
                    g.x += Math.cos(a) * 400 * dt;
                    g.y += Math.sin(a) * 400 * dt;
                }
            }
        }

        for (let i = this.gems.length-1; i >= 0; i--) {
            const g = this.gems[i];
            for (const p of alivePlayers) {
                if (dist(g.x, g.y, p.x, p.y) < 15 + g.radius) {
                    p.xp += g.xp;
                    this.handleLevelUp(p);
                    this.gems.splice(i, 1);
                    break;
                }
            }
        }

        // --- СПАВН ---
        this.spawnTimer += dt;
        const spawnRate = Math.max(0.08, 0.8 - (this.time / 240));
        if (this.spawnTimer >= spawnRate) {
            this.spawnTimer = 0;
            let cx = 0, cy = 0, cnt = 0;
            for (const p of alivePlayers) { cx += p.x; cy += p.y; cnt++; }
            if (cnt === 0) { cx = 0; cy = 0; cnt = 1; } else { cx /= cnt; cy /= cnt; }

            const a = Math.random() * Math.PI * 2;
            const r = 400;
            const df = this.difficultyMultiplier;
            const rnd = Math.random();
            let type = 0;
            if (rnd > 0.9) type = 2;
            else if (rnd > 0.7) type = 1;

            let e;
            if (type === 0) e = { x: cx+Math.cos(a)*r, y: cy+Math.sin(a)*r, hp: 20*df, speed: 90+df*10, baseSpeed: 90+df*10, radius: 12, damage: 10, xp: 10, color: '#ff3300' };
            else if (type === 1) e = { x: cx+Math.cos(a)*r, y: cy+Math.sin(a)*r, hp: 10*df, speed: 200+df*15, baseSpeed: 200+df*15, radius: 8, damage: 5, xp: 15, color: '#ffaa00' };
            else e = { x: cx+Math.cos(a)*r, y: cy+Math.sin(a)*r, hp: 80*df, speed: 55+df*5, baseSpeed: 55+df*5, radius: 20, damage: 25, xp: 30, color: '#550000' };
            e.freezeTimer = 0;
            this.enemies.push(e);
        }

        this.time += dt;
        this.difficultyMultiplier = 1 + (this.time / 60);
        this.broadcastState();
    }

    makeProj(x, y, vx, vy, dmg, pierce, life, radius, color, effect) {
        return { x, y, vx, vy, damage: dmg, pierce, life, radius, color, effect, hitEnemies: new Set() };
    }

    handleLevelUp(p) {
        let msg = '';

        const canEvolve = p.weapons.find(w => w.level >= 8 && EVOLUTIONS[w.id]);
        const canAdd = p.weapons.length < 3;
        const canUpgrade = p.weapons.some(w => w.level < 8);

        const roll = Math.random();

        if (canEvolve && roll < 0.25) {
            // ЭВОЛЮЦИЯ
            const w = p.weapons.find(w => w.level >= 8 && EVOLUTIONS[w.id]);
            const oldName = WEAPONS[w.id]?.name || w.id;
            w.id = WEAPONS[w.id]?.evolve || w.id;
            w.level = 9;
            msg = `⚡ ЭВОЛЮЦИЯ: ${EVOLUTIONS[w.id]?.name || w.id}`;
        } else if (canAdd &&
